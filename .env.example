APP_NAME=Wayy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wayy.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --------------------------------------------------
# Database
# --------------------------------------------------

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=wayy
DB_USERNAME=wayy
DB_PASSWORD=@mj64523

# --------------------------------------------------
# Session
# --------------------------------------------------

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# --------------------------------------------------
# Cache
# --------------------------------------------------

CACHE_STORE=database

# --------------------------------------------------
# Queue
# --------------------------------------------------

QUEUE_CONNECTION=sync

# --------------------------------------------------
# Broadcasting
# --------------------------------------------------

BROADCAST_CONNECTION=log

# --------------------------------------------------
# Filesystem
# --------------------------------------------------

FILESYSTEM_DISK=local

# --------------------------------------------------
# Redis
# --------------------------------------------------

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --------------------------------------------------
# Mail
# --------------------------------------------------

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@wayy.ir"
MAIL_FROM_NAME="${APP_NAME}"

# --------------------------------------------------
# AWS
# --------------------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --------------------------------------------------
# Vite
# --------------------------------------------------

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------
# Application Domain
# --------------------------------------------------

APP.DOMAIN=https://wayy.ir/